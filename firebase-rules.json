{
  "rules": {
    ".read": false,
    ".write": false,

    "days": {
      ".read": true,
      "$day": {
        ".write": true,
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isBoolean()"
      }
    },

    "votes": {
      "$day": {
        ".read": true,
        ".indexOn": ["t"],
        ".write": "!newData.exists()",
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('t').isNumber()",
          "name": {},
          "t": {},
          "$other": { ".validate": false }
        }
      }
    }
  }
}
